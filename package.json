    "cli": "pnpm --filter @queuestorm/cli start"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  },
  "packageManager": "pnpm@11.5.3"
}
