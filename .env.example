# QueueStorm deploy-time configuration. Copy to `.env` and fill in real values.
# NEVER commit the populated .env.

# Existing external Traefik docker network name
TRAEFIK_NETWORK=

# Public hostname Traefik routes to this service (e.g. queuestorm.example.com)
API_HOST=

# Traefik certresolver name that issues the TLS certificate (e.g. letsencrypt)
CERT_RESOLVER=

# Google Gemini API key — used by the analysis path from issue #2 onward
GEMINI_API_KEY=
