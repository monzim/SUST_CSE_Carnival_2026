# QueueStorm configuration. Copy to `.env` and fill in real values.
# NEVER commit the populated .env.

# Host port to publish the API on (default 3000). The service then answers at
# http://localhost:${API_PORT}/health
API_PORT=3000

# ---- LLM provider (the problem statement allows any major provider) ----
# Provider selector: openai (default) | anthropic | google-genai
LLM_PROVIDER=openai
# Optional model override. Defaults per provider:
#   openai -> gpt-5-mini, anthropic -> claude-opus-4-8, google-genai -> gemini-3.5-flash
# (set LLM_MODEL=gpt-5 for max reasoning quality at higher latency/cost)
LLM_MODEL=

# Set the key for whichever provider you selected above.
# OpenAI is the default; it is reachable from regions where the Gemini
# Developer API is geo-blocked ("User location is not supported", e.g. BD).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Gemini key (used when LLM_PROVIDER=google-genai). Geo-restricted:
# call it only from a supported region or via an egress proxy.
GEMINI_API_KEY=
