# QueueStorm deploy-time configuration. Copy to `.env` and fill in real values.
# NEVER commit the populated .env.

# Existing external Traefik docker network name
TRAEFIK_NETWORK=

# Public hostname Traefik routes to this service (e.g. queuestorm.example.com)
API_HOST=

# Traefik certresolver name that issues the TLS certificate (e.g. letsencrypt)
CERT_RESOLVER=

# Google Gemini API key — used by the analysis path from issue #2 onward.
# NOTE: the Gemini Developer API is geo-restricted; calls fail with
# "User location is not supported" from unsupported regions (e.g. BD). Run the
# analysis path from a supported region or via an egress proxy.
GEMINI_API_KEY=

# Optional Gemini model id (default: gemini-3.5-flash; documented fallback:
# gemini-2.5-flash). Resolved via langchain's `google-genai` provider.
GEMINI_MODEL=
