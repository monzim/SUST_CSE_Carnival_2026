{
  "name": "queuestorm",
  "version": "0.1.0",
  "private": true,
  "description": "QueueStorm — AI banking-ticket triage service (SUST CSE Carnival 2026)",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
